{
  "name": "betterblue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.19.0"
  },
  "scripts": {
    "dev": "vite",
    "api": "json-server --watch server/db.json --port 4000 --delay 300",
    "dev:all": "concurrently -n web,api -c auto \"npm:dev\" \"npm:api\"",
    "seed": "node scripts/seed-db.js",
    "build": "vite build",
